# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# liftosaur-sync: local runs (these hold real API credentials; the repo is public)
options.local.json
state.local.json
/share/
/data/

# Private watch FIT files used by tests/real_fit.rs
tests/data/private/

# cargo-fuzz
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
